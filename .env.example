PORT=3000

# Live cash prices from Amadeus Self-Service API (test or prod credentials)
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret

# Optional live points/awards API. If not set, app estimates points from cash fares.
POINTS_API_URL=
POINTS_API_KEY=

# Tracker schedule (every 30 mins default)
TRACKER_CRON=*/30 * * * *
